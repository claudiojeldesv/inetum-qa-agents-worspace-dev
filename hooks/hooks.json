{
  "$schema": "https://docs.claude.com/schemas/hooks.json",
  "comment": "Hooks de qa-automator. Compliance pre-flight bloquea invocaciones del MCP playwright-test contra URLs no declaradas. PII scanner audita .spec.ts recién escritos. Audit-write registra cierre de sesión.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright-test__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/pre-flight.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/pii-post.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/audit-write.ts"
          }
        ]
      }
    ]
  }
}
