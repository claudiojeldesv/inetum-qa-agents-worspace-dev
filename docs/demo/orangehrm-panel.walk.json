  "entry": "/web/index.php/auth/login",
  "flows": [
    {
      "flow": "cp01-acceso",
      "criteria": ["CP-01"],
      "steps": [
        { "id": "s1", "action": "goto", "target": "/web/index.php/auth/login", "screen": "login" },
        { "id": "s2", "action": "fill", "hint": { "role": "textbox", "name": "Username" }, "value": "$fixtures.credentials[0].username" },
        { "id": "s3", "action": "fill", "hint": { "role": "textbox", "name": "Password" }, "value": "$fixtures.credentials[0].password", "secret": true },
        { "id": "s4", "action": "click", "hint": { "role": "button", "name": "Login" }, "expect_transition": true, "screen": "dashboard" },
        { "id": "s5", "action": "expect_text", "value": "Dashboard" }
      ]
