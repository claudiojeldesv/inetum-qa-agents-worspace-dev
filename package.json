{
  "name": "ia4d-qa-automator",
  "version": "0.4.0-beta.2",
  "description": "Agente QA Inetum multi-modo para generación de tests E2E con compliance regulado, marco QA propio y Quality layer Writer+Reviewer+Judge.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "report": "node src/scripts/build-report.mjs",
    "report:showcase": "tsx src/scripts/build-showcase.ts",
    "qa:tokens": "node src/scripts/token-usage.mjs",
    "qa:healthcheck": "tsx src/scripts/healthcheck.ts",
    "qa:fix": "tsx src/scripts/healthcheck.ts --fix",
    "build:template": "node src/scripts/build-template.mjs",
    "build:plugin": "node src/scripts/build-plugin.mjs",
    "build:hooks:copilot": "esbuild copilot/hooks/pre-flight.ts copilot/hooks/audit-write.ts --bundle --platform=node --format=esm --outdir=copilot/hooks/dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.4.1",
    "@cucumber/gherkin": "^39.1.0",
    "@cucumber/messages": "^32.3.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "yaml": "^2.4.0"
  }
}
