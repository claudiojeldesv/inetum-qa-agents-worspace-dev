{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "comment": "Settings versionado del workspace ia4d-qa-automator. Cablea los 3 hooks de qa-automator (compliance pre-flight, PII/anti-fixme post-write, audit-write al cierre) y habilita el MCP playwright-test. Los permisos y overrides de maquina van en settings.local.json (gitignored, lo genera tu CLI).",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["playwright-test"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright-test__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/pre-flight.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/pii-post.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/audit-write.ts"
          }
        ]
      }
    ]
  }
}
