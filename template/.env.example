# Copia este archivo a .env y ajusta los valores. .env está gitignored.

# URL base del target (la setea el command autonomous con --url; este default solo
# aplica a runs manuales de `npm run e2e`). Debe estar permitida en config/allowed-targets.yaml.
QA_BASE_URL=https://www.saucedemo.com/

# Ruta del storageState para auth (la setea el command cuando el style-contract tiene
# auth.enabled). Déjala vacía si el target no requiere login.
# QA_STORAGE_STATE=playwright/.auth/user.json

# --- Gates opcionales (off por defecto, v0.2 design/gates-off-by-default) ---
# Descomenta para activar. Las piezas están completas en el runtime; esto solo las enciende.

# Scanner PII ES (DNI/IBAN/Luhn/teléfono/email). La guarda anti-test.fixme() del mismo
# hook sigue SIEMPRE activa aunque esto esté off.
# QA_ENABLE_PII=1

# Judge: scoring numérico de calidad del test tras Writer+Reviewer.
# QA_ENABLE_JUDGE=1

# --- Variables que los commands setean SOLOS (documentadas por si depuras a mano) ---

# Directorio de artefactos efímeros del run, namespaced por sitio.
# QA_WORK_DIR=.work/<site-id>

# Evidencia visual (las fuerza evidence.level: full del Style Contract).
# QA_SCREENSHOT=on
# QA_TRACE=on
