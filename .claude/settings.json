{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright-test__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/pre-flight.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/pii-post.ts"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx hooks/audit-write.ts"
          }
        ]
      }
    ]
  }
}
